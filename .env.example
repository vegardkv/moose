# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Finn-car specific variables
FINN_SUPABASE_URL=https://your-finn-project.supabase.co
FINN_SUPABASE_KEY=your-finn-anon-key-here
